# OmniSINT Configuration (.env example)
OMNISINT_APP_NAME="OmniSINT"
OMNISINT_DATABASE_PATH=".omnisint_data/omnisint.db"
OMNISINT_CACHE_TTL_SECONDS=86400
OMNISINT_HTTP_TIMEOUT_SECONDS=15.0
OMNISINT_MAX_CONCURRENT_REQUESTS=10

# Optional API Keys for Extended Collectors
OMNISINT_GITHUB_TOKEN=""
OMNISINT_VIRUSTOTAL_API_KEY=""
OMNISINT_GOOGLE_CSE_API_KEY=""
OMNISINT_GOOGLE_CSE_CX=""

# Optional AI Analyst Configuration (supports "deterministic", "ollama", "gemini", "openai")
OMNISINT_LLM_PROVIDER="deterministic"
OMNISINT_LLM_MODEL="gemini-2.5-flash"
OMNISINT_LLM_API_KEY=""
OMNISINT_OLLAMA_BASE_URL="http://localhost:11434"
